# Copy to ../.env or docker/.env for local use. Never commit real secrets.
TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=FoodMate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/FoodMate
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_PASSWORD=foodmate-redis-change-me
# 宿主机 6379 可能被其他 Redis 服务占用；FoodMate 可改用独立端口。
REDIS_PORT=6380
REDIS_URL=redis://:foodmate-redis-change-me@localhost:6380

# Python Runtime 重启后通知 Java 扫描 stale tool_wait checkpoint。
# 只恢复 PostgreSQL 已确认、超出 stale 窗口且没有后续事件的 Run，不自动恢复 waiting_user。
FOODMATE_AGENT_AUTO_RECOVERY_ENABLED=false
FOODMATE_AGENT_RECOVERY_STALE_SECONDS=30
FOODMATE_AGENT_RECOVERY_RECONCILE_LIMIT=20
FOODMATE_AGENT_RECOVERY_RECONCILE_MS=5000
JAVA_CALLBACK_URL=http://localhost:18080

# MinIO (private bucket)
MINIO_ROOT_USER=foodmate-local
MINIO_ROOT_PASSWORD=foodmate-minio-change-me
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=foodmate-local
MINIO_SECRET_KEY=foodmate-minio-change-me
MINIO_BUCKET=foodmate-private
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PRESIGN_TTL_SECONDS=300

# FoodMate application containers
FOODMATE_APP_CONTAINER_NAME=foodmate
FOODMATE_AGENT_CONTAINER_NAME=foodmate-agent-runtime
FOODMATE_APP_PORT=8080
FOODMATE_AGENT_PORT=9002

# M3 hard-delete gate. Both flags must be explicitly enabled only after a
# verified backup and restore rehearsal; keep both disabled for ordinary work.
FOODMATE_RETENTION_EXECUTION_ENABLED=false
FOODMATE_RETENTION_EXECUTION_BACKUP_VERIFIED=false

# Service JWT rotation. Keep old and new public keys comma-separated during overlap;
# values are base64-encoded Ed25519 DER keys and must never be committed with secrets.
RUNTIME_SERVICE_JWT_ENABLED=false
RUNTIME_JAVA_PRIVATE_KEY=
RUNTIME_JAVA_PUBLIC_KEY=
RUNTIME_JAVA_PUBLIC_KEYS=
RUNTIME_JAVA_KID=
RUNTIME_PYTHON_PUBLIC_KEY=
RUNTIME_PYTHON_PUBLIC_KEYS=
RUNTIME_PYTHON_KID=
FOODMATE_PYTHON_PRIVATE_KEY=
FOODMATE_PYTHON_KID=
FOODMATE_JAVA_PUBLIC_KEY=
FOODMATE_JAVA_PUBLIC_KEYS=
FOODMATE_JAVA_PUBLIC_KEY_KID=

# Password reset links
FOODMATE_WEB_BASE_URL=http://localhost:5173

# RocketMQ（ADR-0005 异步主通道，本地单 NameServer + 单 Broker）
# Topic 名只允许 ^[%|a-zA-Z0-9_-]+$，不能使用点号。
ROCKETMQ_IMAGE=apache/rocketmq:5.2.0
ROCKETMQ_PROXY_ADDR=localhost:8081
ROCKETMQ_PROXY_GRPC_PORT=8081
ROCKETMQ_PROXY_REMOTING_PORT=18008
ROCKETMQ_VERSION=5.2.0
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
FOODMATE_ROCKETMQ_NAMESRV_ADDR=localhost:9876
FOODMATE_ROCKETMQ_TOPIC_AGENT_COMMAND=foodmate-agent-command-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_EVENT=foodmate-agent-event-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_PROPOSAL=foodmate-agent-proposal-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_RESULT=foodmate-agent-result-v1
FOODMATE_ROCKETMQ_TOPIC_KNOWLEDGE_INDEX=foodmate-knowledge-index-v1
FOODMATE_ROCKETMQ_TOPIC_KNOWLEDGE_INDEX_RESULT=foodmate-knowledge-index-result-v1
FOODMATE_ROCKETMQ_TOPIC_KNOWLEDGE_VISIBILITY=foodmate-knowledge-visibility-v1
FOODMATE_ROCKETMQ_TOPIC_KNOWLEDGE_PURGE=foodmate-knowledge-purge-v1
FOODMATE_ROCKETMQ_TOPIC_KNOWLEDGE_PURGE_RESULT=foodmate-knowledge-purge-result-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_AGENT_EVENT=foodmate-java-agent-event-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_AGENT_PROPOSAL=foodmate-java-agent-proposal-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_AGENT_COMMAND=foodmate-python-agent-command-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_AGENT_RESULT=foodmate-python-agent-result-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_KNOWLEDGE_INDEX=foodmate-python-knowledge-index-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_KNOWLEDGE_INDEX_RESULT=foodmate-java-knowledge-index-result-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_KNOWLEDGE_VISIBILITY=foodmate-python-knowledge-visibility-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_KNOWLEDGE_PURGE=foodmate-python-knowledge-purge-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_KNOWLEDGE_PURGE_RESULT=foodmate-java-knowledge-purge-result-v1
FOODMATE_KNOWLEDGE_INDEX_CONSUMER_ENABLED=true
FOODMATE_KNOWLEDGE_VISIBILITY_CONSUMER_ENABLED=true
FOODMATE_KNOWLEDGE_PURGE_CONSUMER_ENABLED=true

# Python Agent model routing. These Docker-prefixed variables are intentional:
# host-only cloud settings never enter the container by accident.
FOODMATE_DOCKER_MODEL_FALLBACK_ENABLED=false
FOODMATE_DOCKER_SQL_PLANNER_MODE=stub
FOODMATE_DOCKER_SQL_PLANNER_TIER=standard
FOODMATE_DOCKER_SQL_PLANNER_TIMEOUT_SECONDS=30
FOODMATE_DOCKER_MODEL_TIER_HIGH=deterministic:local
FOODMATE_DOCKER_MODEL_TIER_STANDARD=deterministic:local
FOODMATE_DOCKER_MODEL_TIER_ECONOMY=deterministic:local
FOODMATE_DOCKER_MODEL_TIER_EVAL=deterministic:local
FOODMATE_DOCKER_MODEL_FALLBACK_HIGH=
FOODMATE_DOCKER_MODEL_FALLBACK_STANDARD=
FOODMATE_DOCKER_MODEL_FALLBACK_EVAL=
FOODMATE_DOCKER_AGENT_LLM_EVAL_ENABLED=false
FOODMATE_DOCKER_AGENT_EVAL_MIN_SCORE=0.75
FOODMATE_AGENT_STREAM_CHUNK_MAX_BYTES=2048
FOODMATE_AGENT_STREAM_CHUNK_INTERVAL_MS=150
FOODMATE_AGENT_EVAL_MIN_SCORE=0.75
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_BASE_URL=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_API_KEY=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_TIMEOUT_SECONDS=30
# 价格未知时必须留空，Runtime 会把本次成本记为 unknown；不要填 0 伪造零成本。
# 填写值前必须完成厂商价格表审计，并同步更新 FOODMATE_MODEL_PRICE_VERSION。
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_INPUT_CNY_PER_MILLION_TOKENS=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_OUTPUT_CNY_PER_MILLION_TOKENS=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_CACHED_INPUT_CNY_PER_MILLION_TOKENS=
# 云调用默认必须有已审计价格；deterministic provider 不受该开关影响。
FOODMATE_DOCKER_MODEL_PRICE_AUDIT_REQUIRED=true
# 可按具体模型覆盖供应商级价格，例如（Docker 前缀会映射为容器内变量）：
# FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_DEEPSEEK_AI_DEEPSEEK_V4_FLASH_INPUT_CNY_PER_MILLION_TOKENS=
# FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_DEEPSEEK_AI_DEEPSEEK_V4_FLASH_CACHED_INPUT_CNY_PER_MILLION_TOKENS=
# FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_DEEPSEEK_AI_DEEPSEEK_V4_FLASH_OUTPUT_CNY_PER_MILLION_TOKENS=
# FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_PRIMARY_DEEPSEEK_AI_DEEPSEEK_V4_FLASH_PRICE_VERSION=siliconflow-YYYY-MM-DD
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_BACKUP_BASE_URL=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_BACKUP_API_KEY=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_BACKUP_TIMEOUT_SECONDS=30
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_BACKUP_INPUT_CNY_PER_MILLION_TOKENS=
FOODMATE_DOCKER_MODEL_PROVIDER_CLOUD_BACKUP_OUTPUT_CNY_PER_MILLION_TOKENS=
FOODMATE_DOCKER_MODEL_PRICE_VERSION=unconfigured

# Java AgentRun governance fallback when no active PostgreSQL route row exists.
# Keep deterministic defaults for offline tests; real Docker runs must set all
# provider/model/price values together with the Python Docker model variables.
FOODMATE_DOCKER_MODEL_GOVERNANCE_DEFAULT_PROVIDER=deterministic
FOODMATE_DOCKER_MODEL_GOVERNANCE_DEFAULT_MODEL=qwen-plus
FOODMATE_DOCKER_MODEL_GOVERNANCE_ROUTE_VERSION=env-v1
FOODMATE_DOCKER_MODEL_GOVERNANCE_PRICE_VERSION=env-v1
FOODMATE_DOCKER_MODEL_GOVERNANCE_BUDGET_POLICY_VERSION=env-v1
FOODMATE_DOCKER_MODEL_GOVERNANCE_INPUT_PRICE_PER_MILLION=0
FOODMATE_DOCKER_MODEL_GOVERNANCE_OUTPUT_PRICE_PER_MILLION=0

# 真实付费业务联调门禁；普通启动必须保持关闭。
FOODMATE_DOCKER_PAID_EXECUTION_ENABLED=false
FOODMATE_DOCKER_PAID_MAX_SCENARIOS=4
FOODMATE_DOCKER_PAID_MAX_TOTAL_COST_CNY=5
FOODMATE_DOCKER_PAID_NO_RETRY=true
FOODMATE_DOCKER_PAID_REQUIRE_CLOUD=true
FOODMATE_DOCKER_PAID_EVIDENCE_FILE=

# SiliconFlow OpenAI-compatible Chat provider (optional; default remains deterministic).
# Chat and Embedding credentials are separate. To enable Chat explicitly, set a tier
# to the shared cloud_primary provider and configure its audited price fields above.
# SQL Agent local mode reuses the selected shared Chat tier; it has no separate API key.
# FOODMATE_DOCKER_SQL_PLANNER_MODE=local
# FOODMATE_DOCKER_MODEL_TIER_STANDARD=cloud_primary:deepseek-ai/DeepSeek-V4-Flash
# FOODMATE_DOCKER_MODEL_TIER_HIGH=cloud_primary:deepseek-ai/DeepSeek-V4-Flash
# FOODMATE_DOCKER_MODEL_TIER_EVAL=cloud_primary:deepseek-ai/DeepSeek-V4-Flash

# M2-1 RAG mode
# stub: Redis keyword index only; no Milvus and no embedding credentials.
# local + deterministic: writes deterministic vectors to Milvus without a paid API.
# local + openai-compatible: requires an explicitly configured OpenAI-compatible
# /embeddings endpoint and API key; it never falls back to deterministic or stub.
# These are host-side Compose inputs. The container receives FOODMATE_RAG_*.
FOODMATE_DOCKER_RAG_MODE=stub
FOODMATE_DOCKER_RAG_EMBEDDING_PROVIDER=deterministic
FOODMATE_DOCKER_RAG_EMBEDDING_PROFILE=
FOODMATE_DOCKER_RAG_EMBEDDING_BASE_URL=
FOODMATE_DOCKER_RAG_EMBEDDING_API_KEY=
FOODMATE_DOCKER_RAG_EMBEDDING_MODEL=deterministic-local-v1
# local + openai-compatible profiles (use one at a time and separate collections):
# bge-m3: BAAI/bge-m3
# qwen3-embedding-0.6b: Qwen/Qwen3-Embedding-0.6B
# BGE-M3 profile:
# FOODMATE_DOCKER_RAG_MODE=local
# FOODMATE_DOCKER_RAG_EMBEDDING_PROVIDER=openai-compatible
# FOODMATE_DOCKER_RAG_EMBEDDING_PROFILE=bge-m3
# FOODMATE_DOCKER_RAG_EMBEDDING_MODEL=BAAI/bge-m3
# FOODMATE_DOCKER_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Embedding key must be supplied explicitly; do not inherit the Chat provider key.
# FOODMATE_DOCKER_RAG_EMBEDDING_API_KEY=
# FOODMATE_DOCKER_RAG_MILVUS_COLLECTION=foodmate_knowledge_chunks_bge_m3
# Qwen profile (use a separate collection and re-index the documents):
# FOODMATE_DOCKER_RAG_MODE=local
# FOODMATE_DOCKER_RAG_EMBEDDING_PROVIDER=openai-compatible
# FOODMATE_DOCKER_RAG_EMBEDDING_PROFILE=qwen3-embedding-0.6b
# FOODMATE_DOCKER_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# FOODMATE_DOCKER_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Embedding key must be supplied explicitly; do not inherit the Chat provider key.
# FOODMATE_DOCKER_RAG_EMBEDDING_API_KEY=
# FOODMATE_DOCKER_RAG_MILVUS_COLLECTION=foodmate_knowledge_chunks_qwen3_embedding_0_6b
FOODMATE_DOCKER_RAG_DETERMINISTIC_DIMENSION=64
# The Python runtime runs inside the Compose network, so use the service hostname.
FOODMATE_DOCKER_RAG_MILVUS_URI=http://milvus:19530
FOODMATE_DOCKER_RAG_MILVUS_COLLECTION=foodmate_knowledge_chunks
# 营养目录使用独立集合，避免和上传知识文档的向量、引用规则混用。
FOODMATE_DOCKER_RAG_NUTRITION_MILVUS_COLLECTION=foodmate_nutrition_foods
# local 模式启动索引消费者前探测的 Milvus health endpoint；留空则从 URI 推导 9091/healthz。
FOODMATE_DOCKER_RAG_MILVUS_HEALTH_URL=
FOODMATE_DOCKER_RAG_MILVUS_READY_TIMEOUT_SECONDS=60
FOODMATE_DOCKER_RAG_INDEX_CONCURRENCY=4
FOODMATE_DOCKER_RAG_ITEM_TIMEOUT_SECONDS=20
FOODMATE_DOCKER_RAG_BATCH_TOKEN_LIMIT=100000
FOODMATE_DOCKER_RAG_DAILY_TOKEN_LIMIT=1000000
FOODMATE_DOCKER_RAG_BATCH_COST_LIMIT=0
FOODMATE_DOCKER_RAG_DAILY_COST_LIMIT=0
FOODMATE_DOCKER_RAG_PRICE_PER_MILLION_TOKENS=0
FOODMATE_DOCKER_RAG_PRICE_VERSION=deterministic-v1
FOODMATE_DOCKER_RAG_STUB_REDIS_PREFIX=foodmate:rag:stub
FOODMATE_DOCKER_RAG_NUTRITION_STUB_REDIS_PREFIX=foodmate:rag:nutrition:stub

# Optional outbound proxy for agent-runtime only. Leave empty for direct access.
# Do not use the proxy for Compose-internal services listed in NO_PROXY.
FOODMATE_DOCKER_HTTP_PROXY=
FOODMATE_DOCKER_HTTPS_PROXY=
FOODMATE_DOCKER_NO_PROXY=localhost,127.0.0.1,foodmate,redis,postgres,milvus,minio,rocketmq-proxy
